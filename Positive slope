import pandas as pd
import numpy as np
import yfinance as yf
from scipy.stats import linregress
import urllib.request
import warnings

warnings.filterwarnings("ignore")

# ==================================================
# 1. SCANNER PARAMETERS
# ==================================================
MAX_DAYS = 140  
RANGES = [15, 30, 60, 90, 140]  

print("📡 Fetching Stock List...")

url = "https://archives.nseindia.com/content/indices/ind_nifty500list.csv"
req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})

try:
    nifty500 = pd.read_csv(urllib.request.urlopen(req))
    tickers = [str(s).strip() + ".NS" for s in nifty500["Symbol"]]
except Exception:
    tickers = [
        "ANGELONE.NS", "TATAMOTORS.NS", "RELIANCE.NS", "INFY.NS", "TCS.NS",
        "HDFCBANK.NS", "ICICIBANK.NS", "SBIN.NS", "BHARTIARTL.NS", "ITC.NS"
    ]

print(f"🔎 Total Stocks: {len(tickers)} | Scanning last {MAX_DAYS} candles...\n")


# ==================================================
# 2. SLOPE & RANGE CALCULATOR FUNCTION (WITH DATES)
# ==================================================
def analyze_ranges(symbol, df_close):
    if len(df_close) < MAX_DAYS:
        return None

    close_vals = df_close.values
    dates = df_close.index

    range_analysis = {}
    best_range = None
    best_score = -999
    best_start_date = None
    best_completion_date = None

    for r in RANGES:
        segment = close_vals[-r:]
        segment_dates = dates[-r:]

        seg_min, seg_max = segment.min(), segment.max()
        if seg_max == seg_min:
            continue
        norm_segment = (segment - seg_min) / (seg_max - seg_min)

        x = np.arange(len(norm_segment))
        slope, intercept, r_value, p_value, std_err = linregress(x, norm_segment)
        r_squared = r_value ** 2

        pct_change = ((segment[-1] - segment[0]) / segment[0]) * 100
        combined_score = slope * r_squared

        range_analysis[f"{r}D_Slope"] = round(slope, 4)

        if combined_score > best_score:
            best_score = combined_score
            best_range = f"{r} Days"
            # तारीखों को YYYY-MM-DD फॉर्मेट में निकालें
            best_start_date = pd.to_datetime(segment_dates[0]).strftime('%Y-%m-%d')
            best_completion_date = pd.to_datetime(segment_dates[-1]).strftime('%Y-%m-%d')

    if not range_analysis:
        return None

    return {
        "Symbol": symbol,
        "Best_Range": best_range,
        "Start_Date": best_start_date,            # पैटर्न शुरू होने की तारीख
        "Completion_Date": best_completion_date, # पैटर्न/रेंज खत्म होने की (हालिया) तारीख
        "15D_Slope": range_analysis.get("15D_Slope", 0),
        "30D_Slope": range_analysis.get("30D_Slope", 0),
        "60D_Slope": range_analysis.get("60D_Slope", 0),
        "140D_Slope": range_analysis.get("140D_Slope", 0),
        "Score": round(best_score, 4)
    }


# ==================================================
# 3. BATCH PROCESSOR
# ==================================================
BATCH_SIZE = 50
all_results = []

for i in range(0, len(tickers), BATCH_SIZE):
    batch = tickers[i : i + BATCH_SIZE]
    try:
        data = yf.download(
            batch,
            period="1y",
            auto_adjust=True,
            progress=False,
            group_by="ticker"
        )

        for sym in batch:
            try:
                if len(batch) == 1:
                    df_sym = data
                else:
                    if sym not in data.columns.levels[0]:
                        continue
                    df_sym = data[sym]

                if "Close" in df_sym.columns:
                    close_s = df_sym["Close"].dropna()
                    res = analyze_ranges(sym, close_s)
                    if res:
                        all_results.append(res)
            except Exception:
                continue

    except Exception:
        continue


# ==================================================
# 4. RESULT DISPLAY
# ==================================================
print("=" * 100)
print("🚀 RECENT PATTERN COMPLETION REPORT WITH DATES")
print("=" * 100)

if all_results:
    df_res = pd.DataFrame(all_results)
    df_res = df_res.sort_values(by="Score", ascending=False)

    # मुख्य समरी दिखाएं (तारीखों के साथ)
    output_df = df_res[[
        "Symbol", "Best_Range", "Start_Date", "Completion_Date",
        "15D_Slope", "140D_Slope", "Score"
    ]].head(20)

    print("\n", output_df.to_string(index=False))

    print("\n" + "-" * 100)
    print("💡 नई फ़ील्ड्स की जानकारी:")
    print("1. Start_Date      : उस तारीख को दर्शाती है जब चुनी गई Best_Range का पैटर्न शुरू हुआ था।")
    print("2. Completion_Date : वह हालिया तारीख जिस दिन यह स्लोप/पैटर्न डेटा स्कैनिंग में पूरा हुआ है।")
    print("-" * 100)
else:
    print("❌ डाटा प्राप्त नहीं हो सका।")
