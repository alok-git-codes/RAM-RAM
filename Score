import time
import pandas as pd
import yfinance as yf

def display_title():
    print("\033[1;36m")
    print("    ╔═══════════════════════════════════════════════════════════════════════╗")
    print("    ║       NSE NIFTY 50 LIVE STOCK SCREENER (Using Official CSV)           ║")
    print("    ╚═══════════════════════════════════════════════════════════════════════╝")
    print("\033[0m")
    print("\033[1;33m📊 Downloading Nifty 50 list from NSE & Fetching Live Data 📊\033[0m\n")

# Function to fetch Nifty 50 list directly from NSE archives CSV and fetch live data
def get_nifty50_live_data():
    csv_url = "https://archives.nseindia.com/content/indices/ind_nifty50list.csv"
    
    print("⏳ Downloading Nifty 50 symbols from NSE...")
    try:
        # NSE की वेबसाइट से CSV फाइल रीड कर रहे हैं
        df_nifty = pd.read_csv(csv_url)
        # सिंबल कॉलम से टिकर्स निकाल रहे हैं और Yahoo Finance के लिए .NS जोड़ रहे हैं symbols में
        symbols = [symbol + ".NS" for symbol in df_nifty['Symbol'].tolist()]
    except Exception as e:
        print(f"❌ Error downloading Nifty 50 list: {e}")
        return []

    print(f"✅ Successfully loaded {len(symbols)} stocks. Fetching live prices (this may take a minute)...")
    
    stock_list = []
    
    # टेस्टिंग के लिए आप चाहें तो symbols[:10] कर सकते हैं ताकि शुरुआत में सिर्फ पहले 10 शेयर चेक हों
    for ticker in symbols[:15]:  # फिलहाल 15 शेयर ले रहे हैं ताकि तेजी से रन हो (आप चाहें तो लिमिट बढ़ा सकते हैं)
        try:
            stock = yf.Ticker(ticker)
            hist = stock.history(period="1y")
            info = stock.info
            
            if hist.empty:
                continue
                
            current_price = hist['Close'].iloc[-1]
            ma_50 = hist['Close'].rolling(window=50).mean().iloc[-1]
            ma_200 = hist['Close'].rolling(window=200).mean().iloc[-1] if len(hist) >= 200 else ma_50
            
            pe_ratio = info.get('trailingPE', 20.0)
            if pe_ratio is None: pe_ratio = 20.0
            
            debt_equity = info.get('debtToEquity', 50.0) / 100.0 if info.get('debtToEquity') else 0.5
            dividend_yield = info.get('dividendYield', 0.01) * 100 if info.get('dividendYield') else 0.0
            sector = info.get('sector', 'General')
            
            stock_list.append({
                "symbol": ticker.replace(".NS", ""),
                "current_price": round(float(current_price), 2),
                "ma_50": round(float(ma_50), 2),
                "ma_200": round(float(ma_200), 2),
                "pe_ratio": round(float(pe_ratio), 2),
                "debt_equity": round(float(debt_equity), 2),
                "dividend_yield": round(float(dividend_yield), 2),
                "sector": sector
            })
        except Exception as e:
            # कुछ शेयरों का डेटा Yahoo पर तुरंत न मिलने पर इग्नोर करेगा
            continue
            
    return stock_list

# Main analysis logic
def analyze_stocks(stock_list):
    results = []
    strong_buy, moderate_buy, hold, sell = 0, 0, 0, 0
    
    for stock in stock_list:
        symbol = stock["symbol"]
        current_price = stock["current_price"]
        ma_50 = stock["ma_50"]
        ma_200 = stock["ma_200"]
        pe_ratio = stock["pe_ratio"]
        debt_equity = stock["debt_equity"]
        dividend_yield = stock["dividend_yield"]
        sector = stock["sector"]
        
        technical_score, value_score, financial_health_score, income_score = 0, 0, 0, 0
        
        # Technical Logic
        if current_price > ma_50 and current_price > ma_200:
            technical_score += 2
        elif current_price > ma_50:
            technical_score += 1
        elif current_price < ma_50 and current_price < ma_200:
            technical_score -= 2
            
        if ma_50 > ma_200:
            technical_score += 1
            
        # Value Logic
        if pe_ratio < 15: value_score += 2
        elif pe_ratio < 25: value_score += 1
        elif pe_ratio > 40: value_score -= 1
        
        # Financial Health
        if debt_equity < 0.3: financial_health_score += 2
        elif debt_equity < 0.7: financial_health_score += 1
        elif debt_equity > 1.5: financial_health_score -= 2
        
        # Income
        if dividend_yield > 3.0: income_score += 2
        elif dividend_yield > 1.0: income_score += 1
        
        total_score = technical_score + value_score + financial_health_score + income_score
        
        if total_score >= 5:
            rating = "Strong Buy"
            strong_buy += 1
        elif total_score >= 2:
            rating = "Moderate Buy"
            moderate_buy += 1
        elif total_score >= -1:
            rating = "Hold"
            hold += 1
        else:
            rating = "Sell"
            sell += 1
            
        results.append({
            "symbol": symbol,
            "sector": sector,
            "current_price": current_price,
            "rating": rating,
            "total_score": total_score,
            "pe_ratio": pe_ratio,
            "dividend_yield": dividend_yield
        })
        
    return results, {"strong_buy": strong_buy, "moderate_buy": moderate_buy, "hold": hold, "sell": sell}

def main():
    display_title()
    stocks = get_nifty50_live_data()
    
    if not stocks:
        print("❌ Could not fetch data. Please check internet or NSE link.")
        return
        
    results, counts = analyze_stocks(stocks)
    
    print("\n" + "="*60)
    print("          NIFTY 50 LIVE SCREENING RESULTS          ")
    print("="*60)
    
    for stock in results:
        print(f"🔹 {stock['symbol'].ljust(12)} | Sector: {stock['sector'].ljust(15)} | Price: ₹{str(stock['current_price']).ljust(8)} | Rating: {stock['rating']} ({stock['total_score']:+})")

    print("\n📈 Market Summary:")
    print(f"Strong Buy: {counts['strong_buy']} | Moderate Buy: {counts['moderate_buy']} | Hold: {counts['hold']} | Sell: {counts['sell']}")

if __name__ == "__main__":
    main()
