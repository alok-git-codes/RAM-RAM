import numpy as np
import pandas as pd
import yfinance as yf

# Quantum Optimization & Primitives
from qiskit_algorithms.optimizers import COBYLA
from qiskit_algorithms import QAOA
from qiskit.primitives import StatevectorSampler
from qiskit_optimization import QuadraticProgram
from qiskit_optimization.algorithms import MinimumEigenOptimizer

# 1. NSE Nifty 50 CSV URL का उपयोग करें
url_nifty50 = "https://archives.nseindia.com/content/indices/ind_nifty50list.csv"

try:
    df_nifty50 = pd.read_csv(url_nifty50)
    print(f"Nifty 50 की लिस्ट सफलतापूर्वक लोड हुई! कुल स्टॉक्स: {len(df_nifty50)}")
except Exception as e:
    print(f"CSV लोड करने में समस्या: {e}")

# Yahoo Finance के लिए .NS टिकर बनाएं
all_tickers = [f"{symbol}.NS" for symbol in df_nifty50['Symbol'].tolist()]

# सिमुलेशन स्पीड के लिए पहले 6 स्टॉक्स लें (जैसे: RELIANCE, TCS, HDFCBANK, आदि)
tickers = all_tickers[:6]
budget = 3  # इन 6 में से बेस्ट 3 स्टॉक्स चुनने हैं

print(f"चयनित स्टॉक्स का परीक्षण: {tickers}")

# 2. स्टॉक्स का 1 साल का ऐतिहासिक डेटा डाउनलोड करें
df_download = yf.download(tickers, period='1y', auto_adjust=False)

if 'Adj Close' in df_download.columns:
    data = df_download['Adj Close']
else:
    data = df_download['Close']

# 3. रिटर्न और रिस्क (Covariance) मैट्रिक्स
returns = data.pct_change().dropna()
mu = returns.mean().values * 252       # Expected Annual Return
sigma = returns.cov().values * 252      # Annual Covariance Matrix

n = len(tickers)
q = 0.5  # Risk Factor

# 4. QuadraticProgram प्रॉब्लम बनाएं
qp = QuadraticProgram(name="Nifty50 Quantum Portfolio")

for i in range(n):
    qp.binary_var(name=tickers[i])

linear = -mu
quadratic = q * sigma
qp.minimize(linear=linear, quadratic=quadratic)

# बाधा (Constraint): ठीक 3 स्टॉक्स का ही चयन करना है
linear_constraint = {tickers[i]: 1 for i in range(n)}
qp.linear_constraint(linear=linear_constraint, sense="==", rhs=budget, name="budget")

# 5. QAOA क्वांटम सॉल्वर चलाएं
sampler = StatevectorSampler()
optimizer = COBYLA(maxiter=100)
qaoa = QAOA(sampler=sampler, optimizer=optimizer)

quantum_solver = MinimumEigenOptimizer(qaoa)

print("\nNifty 50 के स्टॉक्स पर क्वांटम ऑप्टिमाइजेशन चल रहा है...")
result = quantum_solver.solve(qp)

# 6. परिणाम
selected_stocks = [tickers[i] for i in range(n) if result.x[i] == 1]

print("\n" + "="*60)
print(" ⚛️ NIFTY 50 QUANTUM OPTIMIZATION RESULTS")
print("="*60)
print(f"क्वांटम मॉडल द्वारा Nifty 50 में से चुने गए टॉप स्टॉक्स: {selected_stocks}")
print(f"बाइनरी Vector (0/1): {result.x}")
print(f"रिस्क-रिटर्न स्कोर (Objective Value): {result.fval:.4f}")
print("="*60)

